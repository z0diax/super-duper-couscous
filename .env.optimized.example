# Build-time configuration for a fully targeted deployment. Copy to the
# frontend build environment only after the installer and both projection
# backfills have completed and their --verify checks pass.
VITE_BASE_PATH="/hrmdorms/dist/"
VITE_API_URL="/hrmdorms/api/state.php"
VITE_DOCUMENT_REGISTRY_TARGETED_READS="1"
VITE_DOCUMENT_DETAIL_TARGETED_READS="1"
VITE_DOCUMENT_TASKS_TARGETED_READS="1"
VITE_DOCUMENT_SEARCH_TARGETED_READS="1"
VITE_DOCUMENT_SHELL_TARGETED_READS="1"
VITE_PAYROLL_TARGETED_READS="1"
VITE_DASHBOARD_TARGETED_READS="1"
VITE_LEAVE_EWP_TARGETED_READS="1"
VITE_LIGHTWEIGHT_STATE_SYNC="1"

# Set these in the PHP process environment, not in the public Vite bundle:
# HRMDO_DOCUMENT_TARGETED_READS_ENABLED=1
# HRMDO_PAYROLL_TARGETED_READS_ENABLED=1
# HRMDO_DASHBOARD_TARGETED_READS_ENABLED=1
# HRMDO_LEAVE_EWP_TARGETED_READS_ENABLED=1

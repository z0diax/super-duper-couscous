# Build paths; API must be on the same origin as the application.
VITE_BASE_PATH="/hrmdorms/dist/"
VITE_API_URL="/hrmdorms/api/state.php"
# Registry rollout: set both flags to 1 only after Phase 2 backfill and --verify.
# VITE_DOCUMENT_REGISTRY_TARGETED_READS is applied when the frontend is built.
VITE_DOCUMENT_REGISTRY_TARGETED_READS="0"
# Independent non-Payroll Document Detail rollout; also applied at build time.
VITE_DOCUMENT_DETAIL_TARGETED_READS="0"
# Independent My Tasks document queue rollout; applied at build time.
VITE_DOCUMENT_TASKS_TARGETED_READS="0"
# Independent always-mounted Header document search and Header/Sidebar document summary reads.
VITE_DOCUMENT_SEARCH_TARGETED_READS="0"
VITE_DOCUMENT_SHELL_TARGETED_READS="0"
# Payroll batches, operational Work Groups, tasks, search, and shell reads.
VITE_PAYROLL_TARGETED_READS="0"
# Operational Dashboard summary and Leave/EWP reads; all default off.
VITE_DASHBOARD_TARGETED_READS="0"
VITE_LEAVE_EWP_TARGETED_READS="0"
# Set in PHP only after testing the corresponding read endpoints:
# HRMDO_DASHBOARD_TARGETED_READS_ENABLED=1
# HRMDO_LEAVE_EWP_TARGETED_READS_ENABLED=1
# Configure in the PHP process after applying and verifying the additive Payroll read projection:
# HRMDO_PAYROLL_TARGETED_READS_ENABLED=1
# Configure this in the PHP process environment, not the Vite build:
# HRMDO_DOCUMENT_TARGETED_READS_ENABLED=1
# Optional development proxy target; never put database credentials in VITE_ variables.
DEV_API_TARGET="http://localhost"
HRMDO_ARCHIVE_DATABASE=document_tracking
